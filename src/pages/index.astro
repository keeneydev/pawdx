---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import DogCard from "../components/DogCard.astro";
import { env } from "cloudflare:workers";

interface Dog {
  id: string;
  dog_name: string;
  caption: string | null;
  link: string | null;
  image_key: string;
}

const db = env.DB;
const { results } = await db
  .prepare("SELECT id, dog_name, caption, link, image_key FROM submissions WHERE status = 'approved' ORDER BY created_at DESC")
  .all<Dog>();

const initialIndex = results.length > 0 ? Math.floor(Math.random() * results.length) : -1;
const initialDog = results[initialIndex];
---

<Layout title="pawdx — dogs of the internet">
  <Header />
  <main class="gallery-page">
    {!initialDog ? (
      <p class="empty">No dogs yet. Be the first to <a href="/submit">submit one</a>!</p>
    ) : (
      <section class="gallery" aria-label="Random dog gallery">
        <div id="dog-card" aria-live="polite">
          <DogCard
            id={initialDog.id}
            dogName={initialDog.dog_name}
            imageKey={initialDog.image_key}
          />
        </div>
        <p class="swipe-hint">Swipe right for the next pup</p>
        <button id="new-dog" type="button">Show me another dog</button>
      </section>
    )}
  </main>

  {initialDog && (
    <script define:vars={{ dogs: results, initialIndex }}>
      const card = document.querySelector("#dog-card .card");
      const button = document.querySelector("#new-dog");
      let currentIndex = initialIndex;
      let startX = 0;
      let dragX = 0;
      let isDragging = false;

      const showNextDog = () => {
        if (!card || dogs.length === 0) return;

        let nextIndex = currentIndex;
        if (dogs.length > 1) {
          while (nextIndex === currentIndex) {
            nextIndex = Math.floor(Math.random() * dogs.length);
          }
        }

        const dog = dogs[nextIndex];
        const image = card.querySelector("img");
        const name = card.querySelector("h2");

        image.src = `/api/image/${dog.image_key}`;
        image.alt = dog.dog_name;
        name.textContent = dog.dog_name;

        currentIndex = nextIndex;
      };

      const resetCard = () => {
        if (!card) return;
        card.style.transform = "";
        card.style.opacity = "";
        card.classList.remove("is-dragging");
      };

      const advanceWithAnimation = () => {
        if (!card || card.classList.contains("is-advancing")) return;
        card.classList.remove("is-dragging");
        card.classList.add("is-advancing");
        card.style.transform = "translateX(120%) rotate(12deg)";
        card.style.opacity = "0";

        window.setTimeout(() => {
          showNextDog();
          card.style.transition = "none";
          card.style.transform = "translateX(-24px) rotate(-2deg)";
          card.style.opacity = "0";

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              card.style.transition = "";
              resetCard();
              card.classList.remove("is-advancing");
            });
          });
        }, 220);
      };

      button?.addEventListener("click", advanceWithAnimation);

      card?.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        startX = event.clientX;
        dragX = 0;
        isDragging = true;
        card.classList.add("is-dragging");
        card.setPointerCapture(event.pointerId);
      });

      card?.addEventListener("pointermove", (event) => {
        if (!isDragging) return;
        dragX = Math.max(0, event.clientX - startX);
        const rotation = Math.min(dragX / 18, 10);
        card.style.transform = `translateX(${dragX}px) rotate(${rotation}deg)`;
      });

      const finishSwipe = (event) => {
        if (!isDragging || !card) return;
        isDragging = false;
        if (card.hasPointerCapture(event.pointerId)) {
          card.releasePointerCapture(event.pointerId);
        }

        if (dragX >= Math.min(120, card.clientWidth * 0.25)) {
          advanceWithAnimation();
        } else {
          resetCard();
        }
      };

      card?.addEventListener("pointerup", finishSwipe);
      card?.addEventListener("pointercancel", finishSwipe);
    </script>
  )}
</Layout>

<style>
  main {
    width: min(100% - 2rem, 720px);
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 4rem) 0;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  #dog-card {
    width: min(100%, 520px);
    perspective: 1000px;
  }

  .swipe-hint {
    margin-bottom: -0.4rem;
    color: #0a2d6e;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  button {
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: #0a2d6e;
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    box-shadow: 0 3px 0 #061c46;
    transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease;
  }

  button:hover {
    background: #123f8d;
    transform: translateY(-1px);
    box-shadow: 0 4px 0 #061c46;
  }

  button:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #061c46;
  }

  button:focus-visible {
    outline: 3px solid #e84ba5;
    outline-offset: 3px;
  }

  .empty {
    text-align: center;
    color: #888;
    padding: 4rem 0;
  }
</style>
