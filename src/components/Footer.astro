---
const phrases = [
  "Made with \u2764\ufe0f in the dog park",
  "Powered by belly rubs",
  "Fueled by zoomies",
  "Built with treats and tail wags",
  "Crafted during walkies",
  "Inspired by good boys and girls",
];

const phrase = phrases[Math.floor(Math.random() * phrases.length)];
---

<footer>
  <p>{phrase}</p>
</footer>

<style>
  footer {
    margin-top: auto;
    padding: 1.5rem 1rem;
    display: flex;
    justify-content: center;
    color: #3f4f3b;
    font-size: 0.85rem;
    font-weight: 500;
  }

  p {
    width: fit-content;
    max-width: 100%;
    padding: 0.65rem 1rem;
    border: 1px solid rgba(216, 212, 202, 0.8);
    border-radius: 999px;
    background: rgba(250, 249, 246, 0.94);
    text-align: center;
    backdrop-filter: blur(4px);
  }
</style>
