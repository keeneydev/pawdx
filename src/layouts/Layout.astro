---
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title = "pawdx" } = Astro.props;

const bgChoice = "pdx-carpet";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={`bg-${bgChoice}`}>
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: #faf9f6;
    color: #1a1a1a;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  a {
    color: #4a6741;
  }

  /* Plain background (current cream look) */
  .bg-plain {
    background: #faf9f6;
  }

  /* PDX Carpet (new teal version) - CodePen-based SVG tile */
  .bg-pdx-carpet {
    background-color: #00B89C;
    background-image: url("data:image/svg+xml;base64,");
    background-size: 185px 370px;
    background-repeat: repeat;
  }

  /* Content readability on patterned backgrounds */
  body:not(.bg-plain) main {
    background: rgba(255, 255, 255, 0.92);
    border-radius: 8px;
    padding: 1.5rem;
    margin-inline: auto;
    max-width: 960px;
  }
</style>
