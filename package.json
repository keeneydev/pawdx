{
  "name": "pawdx",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "setup": "pnpm install && pnpm run db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply pawdx-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pawdx-db --remote",
    "db:new": "wrangler d1 migrations create pawdx-db"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.2",
    "astro": "^7.2.3"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  }
}
